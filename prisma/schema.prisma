// CW Painters — Ritriwill Holdings job/quoting system
// SQLite for prototype; swap datasource to postgresql for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies   CompanyEntity[]
  users       User[]
  leads       Lead[]
  jobs        Job[]
  priceTemplates PriceTemplate[]
  drawSchedules DrawSchedule[]
  workers     Worker[]
  wageRates   WageRate[]
  materialCatalogs MaterialCatalog[]
  materialRequests MaterialRequest[]
}

// ─── Company entity (Riaan can invoice from multiple legal entities) ──────────

model CompanyEntity {
  id              String   @id @default(cuid())
  tenantId        String
  legalName       String
  tradingAs       String?
  vatNumber       String?
  bankName        String?
  bankAccount     String?
  bankBranch      String?
  invoicePrefix   String   @default("INV")
  invoiceSequence Int      @default(1)
  logoUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  invoices        Invoice[]
}

// ─── Users & roles ───────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SALESMAN
  FOREMAN
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  // Foreman Mode — PIN quick-login (Objective 1). Only meaningful for role FOREMAN.
  // pinEnabled is Riaan's per-user kill switch: he wants to trial the app solo
  // before any foreman gets access, so this stays false until he flips it on.
  pinHash      String?
  pinEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  leadsLogged        Lead[]             @relation("LeadLoggedBy")
  jobsManaged        Job[]              @relation("JobSalesman")
  jobsForeman        Job[]              @relation("JobForeman")
  dailyReports       DailySiteReport[]
  jobSiteItemsAdded  JobSiteItem[]      @relation("SiteItemAddedBy")
  materialRequestsMade     MaterialRequest[] @relation("MaterialRequestedBy")
  materialRequestsApproved MaterialRequest[] @relation("MaterialApprovedBy")
  materialRequestsDelivered MaterialRequest[] @relation("MaterialDeliveredBy")
  upliftBatchesSubmitted   UpliftBatch[]  @relation("UpliftSubmittedBy")
  upliftBatchesReconciled  UpliftBatch[]  @relation("UpliftReconciledBy")
  materialPriceChanges MaterialCatalogPriceHistory[]
}

// ─── Workers (site labour — separate from system users) ──────────────────────

model Worker {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  idNumber  String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  wageRates WageRate[]
  timeEntries TimeEntry[]
}

model WageRate {
  id          String   @id @default(cuid())
  tenantId    String
  workerId    String
  ratePerHour Float    // PLACEHOLDER — confirm overtime rules with Riaan
  effectiveFrom DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  worker      Worker   @relation(fields: [workerId], references: [id])
}

// ─── Service categories ───────────────────────────────────────────────────────

enum ServiceCategory {
  PAINTING
  WATERPROOFING
  DAMP_PROOFING
  RUBBERISING
  RENOVATIONS
  MAINTENANCE
  CONSTRUCTION
}

// ─── Draw schedules (configurable per service category) ───────────────────────

model DrawSchedule {
  id              String          @id @default(cuid())
  tenantId        String
  serviceCategory ServiceCategory
  stages          DrawStage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, serviceCategory])
}

model DrawStage {
  id             String       @id @default(cuid())
  drawScheduleId String
  label          String       // e.g. "Deposit", "Progress", "Final"
  percentage     Float        // PLACEHOLDER — confirm with Riaan (e.g. 30/30/40 for exteriors)
  order          Int

  drawSchedule   DrawSchedule @relation(fields: [drawScheduleId], references: [id], onDelete: Cascade)
}

// ─── Price templates ──────────────────────────────────────────────────────────

model PriceTemplate {
  id              String          @id @default(cuid())
  tenantId        String
  serviceCategory ServiceCategory
  description     String
  unit            String?         // e.g. "m²", "lm", "each"
  unitPrice       Float
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
}

// ─── Leads ────────────────────────────────────────────────────────────────────

enum LeadSource {
  PHONE
  WHATSAPP
  EMAIL
  WEBSITE
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  SITE_VISIT_BOOKED
  QUOTE_SENT
  ACCEPTED
  LOST
}

model Lead {
  id          String     @id @default(cuid())
  tenantId    String
  loggedById  String
  clientName  String
  clientEmail String?
  clientPhone String?
  source      LeadSource
  status      LeadStatus @default(NEW)
  address     String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  loggedBy    User       @relation("LeadLoggedBy", fields: [loggedById], references: [id])
  job         Job?
  quotes      Quote[]
}

// ─── Jobs ─────────────────────────────────────────────────────────────────────

enum JobStatus {
  PENDING
  IN_PROGRESS
  ON_HOLD
  COMPLETE
  INVOICED
  CANCELLED
}

model Job {
  id              String          @id @default(cuid())
  tenantId        String
  leadId          String?         @unique
  acceptedQuoteId String?         @unique
  salesmanId      String?
  foremanId       String?
  serviceCategory ServiceCategory
  status          JobStatus       @default(PENDING)
  siteAddress     String
  startDate       DateTime?
  endDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  lead            Lead?           @relation(fields: [leadId], references: [id])
  acceptedQuote   Quote?          @relation("AcceptedQuote", fields: [acceptedQuoteId], references: [id])
  salesman        User?           @relation("JobSalesman", fields: [salesmanId], references: [id])
  foreman         User?           @relation("JobForeman", fields: [foremanId], references: [id])
  quotes          Quote[]         @relation("JobQuotes")
  invoices        Invoice[]
  dailyReports    DailySiteReport[]
  timeEntries     TimeEntry[]
  clientSignOff   ClientSignOff?
  worksheet       ForemanWorksheet?
  siteItems       JobSiteItem[]
  materialRequests MaterialRequest[]
  upliftBatches   UpliftBatch[]
}

// ─── Quotes ───────────────────────────────────────────────────────────────────

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id              String      @id @default(cuid())
  tenantId        String?
  jobId           String?
  leadId          String?
  quoteNumber     String      @unique
  serviceCategory ServiceCategory
  status          QuoteStatus @default(DRAFT)
  clientName      String
  clientEmail     String?
  clientPhone     String?
  siteAddress     String
  notes           String?
  vatRate         Float       @default(0.15) // PLACEHOLDER — 15% VAT, confirm with Riaan
  subtotal        Float       @default(0)
  vatAmount       Float       @default(0)
  total           Float       @default(0)
  validUntil      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lead            Lead?       @relation(fields: [leadId], references: [id])
  job             Job?        @relation("JobQuotes", fields: [jobId], references: [id])
  acceptedByJob   Job?        @relation("AcceptedQuote")
  lineItems       QuoteLineItem[]
}

model QuoteLineItem {
  id              String  @id @default(cuid())
  quoteId         String
  isCustom        Boolean @default(false) // true = free-form, false = from PriceTemplate
  templateId      String?
  description     String
  unit            String?
  quantity        Float
  unitPrice       Float
  lineTotal       Float

  quote           Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// ─── Foreman worksheet ────────────────────────────────────────────────────────

model ForemanWorksheet {
  id        String   @id @default(cuid())
  jobId     String   @unique
  content   String   // JSON-serialised simplified view of the accepted quote
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job       Job      @relation(fields: [jobId], references: [id])
}

// ─── Daily site reports ───────────────────────────────────────────────────────

model DailySiteReport {
  id          String   @id @default(cuid())
  jobId       String
  loggedById  String
  reportDate  DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job         Job      @relation(fields: [jobId], references: [id])
  loggedBy    User     @relation(fields: [loggedById], references: [id])
  materials   MaterialUsed[]
  photos      SitePhoto[]
  toolConfirmations SiteItemConfirmation[]
}

model MaterialUsed {
  id          String          @id @default(cuid())
  reportId    String
  description String
  quantity    Float
  unit        String?
  // Two-stage fill (Objective 1b): the foreman logs description + quantity only,
  // never a price. Admin comes back later and attaches invoiceNumber + unitCost
  // asynchronously — so both are nullable at creation.
  unitCost    Float?
  totalCost   Float?
  invoiceNumber String?
  // Paint colour — mandatory whenever the source catalog item requiresColor.
  color       String?
  // Links back to the job's persistent roster / the request that created this
  // reading, so the office can trace where a line came from. Both optional —
  // a desktop-entered ad-hoc material (old flow) has neither.
  jobSiteItemId     String?
  materialRequestId String?  @unique
  // Day-over-day anomaly flag (Objective 1b) — set at creation time by comparing
  // against the same job+item's most recent prior reading. See
  // src/lib/anomalyCheck.ts for the exact rule.
  anomalyFlag Boolean         @default(false)
  anomalyNote String?
  createdAt   DateTime        @default(now())

  report          DailySiteReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  jobSiteItem     JobSiteItem?     @relation(fields: [jobSiteItemId], references: [id])
  materialRequest MaterialRequest? @relation(fields: [materialRequestId], references: [id])
}

model SitePhoto {
  id        String          @id @default(cuid())
  reportId  String
  url       String          // local file path for prototype; swap for CDN URL in production
  caption   String?
  createdAt DateTime        @default(now())

  report    DailySiteReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

// ─── Time entries (clock-in/out) ──────────────────────────────────────────────

enum VerificationMethod {
  MANUAL  // prototype: manual UI entry
  KIOSK   // future: facial-recognition kiosk (Jibble/SmartBarrel)
}

model TimeEntry {
  id                 String             @id @default(cuid())
  jobId              String
  workerId           String
  clockIn            DateTime
  clockOut           DateTime?
  hoursWorked        Float?             // computed on clock-out
  mileage            Float?             // optional — km for this entry/trip (Objective 1b timesheet)
  reason             String?            // optional — never mandatory, always available to fill in
  verificationMethod VerificationMethod @default(MANUAL)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  job                Job                @relation(fields: [jobId], references: [id])
  worker             Worker             @relation(fields: [workerId], references: [id])
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

enum InvoiceType {
  DEPOSIT
  STAGE
  FINAL
  VARIATION
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id              String        @id @default(cuid())
  jobId           String
  companyEntityId String
  invoiceNumber   String        @unique
  type            InvoiceType
  status          InvoiceStatus @default(DRAFT)
  drawStageLabel  String?
  drawPercentage  Float?
  subtotal        Float
  vatAmount       Float
  total           Float
  amountPaid      Float         @default(0)
  dueDate         DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  job             Job           @relation(fields: [jobId], references: [id])
  companyEntity   CompanyEntity @relation(fields: [companyEntityId], references: [id])
}

// ─── Client sign-off ──────────────────────────────────────────────────────────

model ClientSignOff {
  id          String   @id @default(cuid())
  jobId       String   @unique
  signedByName String
  signedAt    DateTime @default(now())
  notes       String?

  job         Job      @relation(fields: [jobId], references: [id])
}

// ─── Material catalog (Objective 1b) ───────────────────────────────────────────
// Drives the Foreman Mode report picker. Distinct from the quote-facing
// PriceTemplate: this is unit-cost-of-goods, editable by Admin, with history.

model MaterialCatalog {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  unit             String?          // e.g. "L", "each", "roll"
  currentUnitPrice Float?           // nullable — a brand-new item may start unpriced
  colorRequired    Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant                         @relation(fields: [tenantId], references: [id])
  siteItems        JobSiteItem[]
  materialRequests MaterialRequest[]
  priceHistory     MaterialCatalogPriceHistory[]
}

model MaterialCatalogPriceHistory {
  id          String   @id @default(cuid())
  catalogId   String
  oldPrice    Float?
  newPrice    Float?
  changedById String
  changedAt   DateTime @default(now())

  catalog     MaterialCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  changedBy   User            @relation(fields: [changedById], references: [id])
}

// ─── Job site item roster (Objective 1b) ───────────────────────────────────────
// "What's on this site" — the Admin-seeded (or foreman-added, for a physically
// present one-off tool) list that a Foreman Mode daily report is checked
// against. TOOL rows persist and are re-confirmed report after report until
// uplifted; CONSUMABLE rows just mark "this type of material belongs on this
// job" — the actual day's quantity lives on MaterialUsed, one fresh row per
// report, linked back here via jobSiteItemId.

enum SiteItemType {
  TOOL
  CONSUMABLE
}

enum SiteItemStatus {
  ON_SITE
  UPLIFTED
}

model JobSiteItem {
  id            String         @id @default(cuid())
  jobId         String
  type          SiteItemType
  catalogId     String?        // set for a CONSUMABLE sourced from the catalog
  name          String         // denormalised display name (catalog name, or a custom tool's typed name)
  status        SiteItemStatus @default(ON_SITE)
  addedById     String
  foremanAdded  Boolean        @default(false) // true = foreman typed this in on-site, not Admin-planned
  createdAt     DateTime       @default(now())
  upliftedAt    DateTime?

  job           Job                    @relation(fields: [jobId], references: [id])
  catalog       MaterialCatalog?       @relation(fields: [catalogId], references: [id])
  addedBy       User                   @relation("SiteItemAddedBy", fields: [addedById], references: [id])
  confirmations SiteItemConfirmation[]
  materialsUsed MaterialUsed[]
  materialRequests MaterialRequest[]
  upliftBatchItems UpliftBatchItem[]
}

// One row per TOOL per report — the foreman's "yes it's still here" tick.
model SiteItemConfirmation {
  id            String   @id @default(cuid())
  reportId      String
  jobSiteItemId String
  present       Boolean  @default(true)
  createdAt     DateTime @default(now())

  report        DailySiteReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  jobSiteItem   JobSiteItem     @relation(fields: [jobSiteItemId], references: [id])

  @@unique([reportId, jobSiteItemId])
}

// ─── Material requests (restock) — Objective 1b ────────────────────────────────
// Foreman asks for more of something; Admin approves/rejects; once delivered
// the foreman confirms quantity received, which is what actually adds cost
// (via the linked MaterialUsed row created on delivery-confirm).

enum MaterialRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
}

model MaterialRequest {
  id              String                 @id @default(cuid())
  tenantId        String
  jobId           String
  jobSiteItemId   String?                // set when topping up an item already on the roster
  catalogId       String?                // set when requesting a known catalog item not yet on the roster
  customItemName  String?                // set for something not in the catalog at all
  requestedQty    Float
  unit            String?
  note            String?
  status          MaterialRequestStatus  @default(PENDING)
  requestedById   String
  requestedAt     DateTime               @default(now())
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  deliveredQty    Float?
  deliveredConfirmedById String?
  deliveredConfirmedAt   DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  job             Job              @relation(fields: [jobId], references: [id])
  jobSiteItem     JobSiteItem?     @relation(fields: [jobSiteItemId], references: [id])
  catalog         MaterialCatalog? @relation(fields: [catalogId], references: [id])
  requestedBy     User             @relation("MaterialRequestedBy", fields: [requestedById], references: [id])
  approvedBy      User?            @relation("MaterialApprovedBy", fields: [approvedById], references: [id])
  deliveredConfirmedBy User?       @relation("MaterialDeliveredBy", fields: [deliveredConfirmedById], references: [id])
  resultingMaterialUsed MaterialUsed?
}

// ─── Uplift workflow — Objective 1b ────────────────────────────────────────────
// Two-stage: foreman submits a batch (gated behind confirming everything
// currently on site), then Admin does a final reconciliation pass.

enum UpliftBatchStatus {
  SUBMITTED
  RECONCILED
}

enum UpliftItemStatus {
  PRESENT
  MISSING
  EXCEPTION
}

model UpliftBatch {
  id                   String            @id @default(cuid())
  jobId                String
  submittedByForemanId String
  submittedAt          DateTime          @default(now())
  status               UpliftBatchStatus @default(SUBMITTED)
  officeReconciledAt   DateTime?
  officeReconciledById String?

  job                  Job               @relation(fields: [jobId], references: [id])
  submittedByForeman   User              @relation("UpliftSubmittedBy", fields: [submittedByForemanId], references: [id])
  officeReconciledBy   User?             @relation("UpliftReconciledBy", fields: [officeReconciledById], references: [id])
  items                UpliftBatchItem[]
}

model UpliftBatchItem {
  id              String            @id @default(cuid())
  batchId         String
  jobSiteItemId   String
  status          UpliftItemStatus  @default(PRESENT)
  exceptionReason String?

  batch           UpliftBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  jobSiteItem     JobSiteItem @relation(fields: [jobSiteItemId], references: [id])

  @@unique([batchId, jobSiteItemId])
}
